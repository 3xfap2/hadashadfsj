# Все настройки бота. Локально скопируйте в .env, на хостинге заведите как переменные окружения.

# Токен бота от @BotFather. Обязателен.
BOT_TOKEN=

# Адрес API «Остатка»
API_URL=http://localhost:5078

# Как часто опрашивать стоп-лист и партии, секунд
POLL_SECONDS=30

# Каталог для данных бота: там лежит bot.sqlite3 с токенами чатов и состоянием для уведомлений.
# На хостинге укажите путь к постоянному диску, иначе после перезапуска всем придётся войти заново.
DATA_DIR=data

# Часовой пояс для дат в сообщениях
TIMEZONE=Europe/Moscow

# Необязательно. Если задан, бот отвечает «ok» на GET / и /health на этом порту.
# Нужен хостингам, которые требуют открытый HTTP-порт; многие подставляют его сами.
PORT=
