<Project Sdk="Microsoft.NET.Sdk">

  <!-- Нагрузочный прогон. Не входит в Ostatok.slnx, поэтому обычный dotnet test его не собирает и не запускает:
       запуск и сценарии — в Program.cs и в README, раздел «Нагрузка». -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NBomber" Version="6.1.0" />
  </ItemGroup>

</Project>
